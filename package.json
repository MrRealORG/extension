{
  "name": "dream-extension",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/package.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "check": "npm test && npm run build",
    "format": "prettier --write src public/extension scripts tests *.js *.json *.html *.md docs",
    "format:check": "prettier --check src public/extension scripts tests *.js *.json *.html *.md docs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@sparticuz/chromium": "^153.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "vite": "^6.3.5"
  }
}
